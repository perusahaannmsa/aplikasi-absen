{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "staff"] },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Worker attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "date": { "type": "string" },
        "checkInTime": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["workerId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Daily attendance records"
    }
  }
}
